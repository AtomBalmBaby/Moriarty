
{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Extension",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "env": {
        "TWINNY_DEV_PROVIDERS_FILE": "${workspaceFolder}/src/test/twinny-providers.json",
        "TWINNY_DEV_PROVIDERS_OVERRIDE": "1"
      },
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "${workspaceFolder}/example",
        "${workspaceFolder}"
      ],
      "outFiles": [
        "${workspaceFolder}/out/**/*.js"
      ],
      "preLaunchTask": "npm: build"
    },
    {
      "name": "Twinny Tests",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "env": {
        "TWINNY_DEV_PROVIDERS_FILE": "${workspaceFolder}/src/test/twinny-providers.json",
        "TWINNY_DEV_PROVIDERS_OVERRIDE": "1"
      },
      "args": [
        "--disable-extensions",
        "--extensionDevelopmentPath=${workspaceFolder}",
        "--extensionTestsPath=${workspaceFolder}/out/test/suite/index",
        "${workspaceFolder}/example",
        "${workspaceFolder}"
      ],
      "outFiles": [
        "${workspaceFolder}/out/**/*.js"
      ],
      "preLaunchTask": "build-extension-and-tests"
    }
  ]
}
